*.py[cod]
*$py.class
*.so
.Python
env/
.venv
venv/
ENV/
build/
develop-eggs/
dist/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# --- Database & Storage (CRITICAL) ---
*.db
*.sqlite
*.db-shm
*.db-wal
data/
uploads/
vector_db/
chroma/
vector_cache/
models/
cache/
temp/
scratch/
brain/
.brain/
.system_generated/

# --- Environment & Secrets (NEVER PUSH) ---
.env
.env.local
frontend/.env
frontend/.env.local
secrets.json
config.local.json
*.pem
*.key

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.next/
out/
.vercel

# --- Logs ---
*.log
logs/
server_error.log
server_output.log
error.log
output.log

# --- Personal / Development Junk ---
