# TiO Environment Configuration — EXAMPLE FILE
# Copy this to .env and fill in your real values.
# NEVER commit .env to version control.

# --- LLM Provider ---
# Options: openrouter | gemini | ollama
LLM_PROVIDER=ollama

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- OpenRouter ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# --- Ollama (local) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Server ---
HOST=127.0.0.1
PORT=8888

# --- Tavily Search (optional) ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- Hugging Face ---
HF_TOKEN=your_hf_token_here

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./tio.db

# --- Security ---
SECRET_KEY=generate_a_secure_secret_key_here
JWT_SECRET_KEY=generate_a_secure_jwt_secret_here

# --- Storage ---
UPLOAD_DIR=./data/uploads
CHROMA_DIR=./data/chroma

# --- Redis (optional, fallback to in-memory) ---
REDIS_URL=redis://localhost:6379/0
