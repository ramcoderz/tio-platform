# ─────────────────────────────────────────────────────────────
# TiO — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── LLM (Ollama) ─────────────────────────────────────────────
# Model name as listed in `ollama list`
OLLAMA_MODEL=llama3.2

# Ollama server URL (default when running locally)
OLLAMA_BASE_URL=http://localhost:11434

# ── Authentication ────────────────────────────────────────────
# Strong random string — change this before any deployment
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-strong-random-secret

# Token lifetime in minutes (1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440

# ── Database ──────────────────────────────────────────────────
# SQLite (default, no extra setup)
DATABASE_URL=sqlite+aiosqlite:///./data/tio.db

# PostgreSQL alternative (uncomment and fill in for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/tio

# ── Vector Store ──────────────────────────────────────────────
CHROMA_DIR=./data/chroma

# ── File Storage ──────────────────────────────────────────────
UPLOAD_DIR=./data/uploads

# Maximum ingested file size in megabytes
MAX_FILE_SIZE_MB=25

# ── Cache (optional) ──────────────────────────────────────────
# If Redis is not running, the system falls back to in-memory cache automatically.
REDIS_URL=redis://localhost:6379

# ── Crawling ──────────────────────────────────────────────────
# Maximum pages crawled per website ingestion
MAX_CRAWL_PAGES=50

# Crawl depth (2 = homepage + one level of internal links)
CRAWL_DEPTH=2
